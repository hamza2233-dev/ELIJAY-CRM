# ==== Auth ====
# Admin login credentials (never commit real values — set these in Vercel env vars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-vercel

# Secret used to sign session cookies (generate a random 32+ char string)
SESSION_SECRET=replace-with-a-long-random-string

# ==== Gemini AI QA ====
# Get a fresh key from https://aistudio.google.com/apikey — DO NOT reuse a key
# that has ever been pasted into a chat or committed to a repo.
GEMINI_API_KEY=

# ==== Google Sheets Sync (optional) ====
GOOGLE_SHEET_ID=1jwAXhwds1aVZl_9JrKSnHWCbJwKOz1e97Py-cvtMOyw
# Service account credentials JSON, base64-encoded (see README for how to generate)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
